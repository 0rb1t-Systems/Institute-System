# Frontend (Vite) — safe to expose in the browser
VITE_SUPABASE_URL=https://jtfgfrmpkbglbxtdfnnk.supabase.co
VITE_SUPABASE_ANON_KEY=

# Tenant public URLs: https://{subdomain}.{VITE_APP_ROOT_DOMAIN}
# Leave empty on localhost (uses window.location.origin)
VITE_APP_ROOT_DOMAIN=

# EmailJS fallback (used only if Resend Edge secrets are not set)
VITE_EMAILJS_SERVICE_ID=service_ytic6zi
VITE_EMAILJS_TEMPLATE_ID=template_6aw3exi
VITE_EMAILJS_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Server / Edge Function ONLY — DO NOT put these in Vite or commit real values.
# Set them in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# After adding functions, also add Auth redirect URLs (platform only — custom domains
# do NOT need per-tenant Auth URLs; password reset always uses {slug}.{root}):
#   https://tvetflow.online/**
#   https://*.tvetflow.online/**
#   http://localhost:5173/**
# Custom domain (manage-custom-domain edge function) — set once so tenants self-serve:
#   VERCEL_TOKEN=           # Vercel account token with domain scope
#   VERCEL_PROJECT_ID=      # Vercel project id for the SPA
#   VERCEL_TEAM_ID=         # optional team id
#   APP_ROOT_DOMAIN=tvetflow.online
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
#
# Resend (recommended for inbox delivery — verify your domain in Resend first)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Your Center <noreply@yourdomain.com>
